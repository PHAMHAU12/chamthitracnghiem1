        async function processAndGradeCanvasImage(sourceCanvas, labelPrefix = 'Phiếu') {
            const t0 = performance.now();
            const w = sourceCanvas.width;
            const h = sourceCanvas.height;
            const ctx = sourceCanvas.getContext('2d');
            const imgData = ctx.getImageData(0, 0, w, h);

            const geo = activeSheetGeometry || buildSheetGeometry(appState.config);
            const corners = detectFourCornersFromImageData(imgData, w, h);
            const thresh = (appState.grading.threshold || 45) / 100;

            // 1. Đọc Mã đề viết tay bằng bút mực (Gemini Vision AI hoặc Offline)
            const ocrRes = await recognizeHandwrittenExamCode(sourceCanvas, geo, corners);
            const detectedCode = ocrRes.code;

            const scaleX = Math.hypot(corners.tr.x - corners.tl.x, corners.tr.y - corners.tl.y) / geo.scanW;
            const detectedData = { part1: [], part2: [], part3: [] };

            // 2. Đọc Phần I
            geo.part1Bubbles.forEach(q => {
                const scored = q.options.map(opt => {
                    const pt = mapNormalizedToImagePoint(opt.nx, opt.ny, corners);
                    const rImg = Math.max(3, opt.pr * scaleX);
                    const fill = measureBubbleFillScore(imgData, w, h, pt.x, pt.y, rImg);
                    return { label: opt.label, fill, px: pt.x, py: pt.y, pr: rImg };
                });
                const selected = scored.filter(s => s.fill >= thresh);
                detectedData.part1.push({ qNum: q.qNum, selected, allOptions: scored });
            });

            // 3. Đọc Phần II
            geo.part2Bubbles.forEach(q => {
                const subs = q.subs.map(s => {
                    const pT = mapNormalizedToImagePoint(s.trueBubble.nx, s.trueBubble.ny, corners);
                    const pF = mapNormalizedToImagePoint(s.falseBubble.nx, s.falseBubble.ny, corners);
                    const rImg = Math.max(3, s.trueBubble.pr * scaleX);
                    const fT = measureBubbleFillScore(imgData, w, h, pT.x, pT.y, rImg);
                    const fF = measureBubbleFillScore(imgData, w, h, pF.x, pF.y, rImg);

                    let picked = '';
                    if (fT >= thresh && fF < thresh) picked = 'Đ';
                    else if (fF >= thresh && fT < thresh) picked = 'S';
                    else if (fT >= thresh && fF >= thresh) picked = 'DUP';

                    return {
                        subLabel: s.subLabel,
                        picked,
                        trueBubble: { px: pT.x, py: pT.y, pr: rImg },
                        falseBubble: { px: pF.x, py: pF.y, pr: rImg }
                    };
                });
                detectedData.part2.push({ qNum: q.qNum, subs });
            });

            // 4. Đọc Phần III
            geo.part3Bubbles.forEach(q => {
                let studentStr = '';
                const colResults = [];
                for (let c = 0; c < 4; c++) {
                    const colBubbles = q.cols[c].map(b => {
                        const pt = mapNormalizedToImagePoint(b.nx, b.ny, corners);
                        const rImg = Math.max(2.5, b.pr * scaleX);
                        const fill = measureBubbleFillScore(imgData, w, h, pt.x, pt.y, rImg);
                        return { label: b.label, fill, px: pt.x, py: pt.y, pr: rImg };
                    });
                    const pickedList = colBubbles.filter(cb => cb.fill >= thresh);
                    if (pickedList.length === 1) {
                        studentStr += pickedList[0].label;
                        colResults.push({ picked: pickedList[0], colBubbles });
                    } else {
                        colResults.push({ picked: null, colBubbles });
                    }
                }
                detectedData.part3.push({ qNum: q.qNum, studentStr, colResults });
            });

            // 5. Tính điểm theo cấu hình thang điểm & vẽ kết quả
            const evalRes = evaluateStudentAnswers(detectedData, detectedCode);
            const scoreStr = `${evalRes.score.toFixed(2)}/${evalRes.maxPossibleScore.toFixed(2)}`;
            const previewDataUrl = renderGradedOverlayCanvas(sourceCanvas, evalRes.overlays, detectedCode, scoreStr);

            const elapsed = Math.round(performance.now() - t0);
            const resultId = Date.now() + Math.floor(Math.random() * 1000);

            const record = {
                id: resultId,
                studentName: `${labelPrefix} #${appState.results.length + 1}`,
                examCode: detectedCode,
                correctCount: evalRes.correctCount,
                totalQuestions: evalRes.totalQuestions,
                score: evalRes.score,
                maxScore: evalRes.maxPossibleScore,
                wrongSummary: evalRes.wrongDetails.length > 0 ? evalRes.wrongDetails.slice(0, 6).join(', ') + (evalRes.wrongDetails.length > 6 ? '...' : '') : 'Chính xác tuyệt đối',
                detectedData,
                previewDataUrl
            };

            appState.results.unshift(record);
            lastGradedContext = {
                recordId: resultId,
                sourceCanvas,
                detectedData
            };

            saveAppState();
            updateLatestGradeCard(record, ocrRes, elapsed, evalRes.wrongDetails);
            renderResultsTable();
            playBeepSound();

            return record;
        }

