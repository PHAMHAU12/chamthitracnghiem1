        async function toggleCamera() {
            const panel = document.getElementById('cameraPanel');
            const video = document.getElementById('cameraVideo');
            const btnText = document.getElementById('btnCameraText');

            if (cameraStream) {
                cameraStream.getTracks().forEach(t => t.stop());
                cameraStream = null;
                if (autoCaptureTimer) {
                    clearInterval(autoCaptureTimer);
                    autoCaptureTimer = null;
                }
                panel.classList.add('hidden');
                btnText.textContent = 'Bật Camera trực tiếp';
                return;
            }

            try {
                cameraStream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: currentFacingMode, width: { ideal: 1920 }, height: { ideal: 1080 } },
                    audio: false
                });
                video.srcObject = cameraStream;
                panel.classList.remove('hidden');
                btnText.textContent = 'Tắt Camera';
                showToast('Camera đã sẵn sàng! Hãy căn 4 ô vuông đen vào khung.');
            } catch (err) {
                showToast('Không thể mở Camera (kiểm tra quyền truy cập hoặc kết nối HTTPS).');
            }
        }

