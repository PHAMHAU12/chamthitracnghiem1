        async function handleBatchImageUpload(event) {
            const files = Array.from(event.target.files || []);
            if (files.length === 0) return;

            showToast(`Đang xử lý ${files.length} ảnh phiếu...`);
            for (const file of files) {
                await new Promise(resolve => {
                    const img = new Image();
                    img.onload = async () => {
                        const c = document.createElement('canvas');
                        c.width = img.width;
                        c.height = img.height;
                        c.getContext('2d').drawImage(img, 0, 0);
                        const baseName = file.name.replace(/\.[^/.]+$/, '');
                        await processAndGradeCanvasImage(c, baseName);
                        URL.revokeObjectURL(img.src);
                        resolve();
                    };
                    img.onerror = resolve;
                    img.src = URL.createObjectURL(file);
                });
            }
            event.target.value = '';
            showToast(`Hoàn tất chấm ${files.length} phiếu!`);
        }

        async function runSimulatedSampleGrade() {
            // Đảm bảo có đáp án để đối chiếu
            const keyObj = getCurrentKeyObj();
            const hasAnyKey = Object.values(keyObj.part1).some(Boolean)
                || Object.keys(keyObj.part2).length > 0
                || Object.values(keyObj.part3).some(Boolean);
            if (!hasAnyKey) {
                generateRandomAnswerKey();
            }

            const curKey = getCurrentKeyObj();
            const opts = ['A', 'B', 'C', 'D'];
            const sampleFill = {
                examCode: appState.grading.selectedCode,
                part1: {},
                part2: {},
                part3: {}
            };

            // Tạo bài làm mẫu đúng ~85% để kiểm thử trực quan
            for (let q = 1; q <= appState.config.part1Count; q++) {
                const truth = curKey.part1[q] || 'A';
                sampleFill.part1[q] = Math.random() < 0.85 ? truth : opts[(opts.indexOf(truth) + 1) % 4];
            }
            for (let q = 1; q <= appState.config.part2Count; q++) {
                const tObj = curKey.part2[q] || { a: 'Đ', b: 'S', c: 'Đ', d: 'S' };
                sampleFill.part2[q] = {
                    a: Math.random() < 0.85 ? tObj.a : (tObj.a === 'Đ' ? 'S' : 'Đ'),
                    b: Math.random() < 0.85 ? tObj.b : (tObj.b === 'Đ' ? 'S' : 'Đ'),
                    c: Math.random() < 0.85 ? tObj.c : (tObj.c === 'Đ' ? 'S' : 'Đ'),
                    d: Math.random() < 0.85 ? tObj.d : (tObj.d === 'Đ' ? 'S' : 'Đ')
                };
            }
            for (let q = 1; q <= appState.config.part3Count; q++) {
                const tStr = curKey.part3[q] || '12';
                sampleFill.part3[q] = Math.random() < 0.85 ? tStr : '99';
            }

            const simCanvas = document.createElement('canvas');
            renderSingleOmrSheetToCanvas(simCanvas, appState.config, sampleFill);
            await processAndGradeCanvasImage(simCanvas, 'Phiếu mẫu');
        }

