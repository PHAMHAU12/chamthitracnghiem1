        document.getElementById('examTitleInput').addEventListener('input', (e) => {
            appState.config.examTitle = e.target.value;
            refreshOmrDesignAndSync();
        });

        document.getElementById('subjectInput').addEventListener('input', (e) => {
            appState.config.subjectName = e.target.value;
            refreshOmrDesignAndSync();
        });

        document.getElementById('durationInput').addEventListener('input', (e) => {
            appState.config.duration = e.target.value;
            refreshOmrDesignAndSync();
        });

        document.getElementById('quickKeyStringInput').addEventListener('input', (e) => {
            const clean = e.target.value.toUpperCase().replace(/[^ABCD-]/g, '');
            const keyObj = getCurrentKeyObj();
            for (let q = 1; q <= appState.config.part1Count; q++) {
                const ch = clean[q - 1];
                keyObj.part1[q] = (ch && 'ABCD'.includes(ch)) ? ch : '';
            }
            saveAppState();
            syncGradingTabUI();
        });

        ['ptsPart1Input', 'ptsPart2Input', 'ptsPart3Input'].forEach((id, idx) => {
            document.getElementById(id).addEventListener('input', (e) => {
                const val = Math.max(0, parseFloat(e.target.value) || 0);
                appState.grading.scorePreset = 'custom';
                if (idx === 0) appState.grading.ptsPart1 = val;
                if (idx === 1) appState.grading.ptsPart2 = val;
                if (idx === 2) appState.grading.ptsPart3 = val;
                saveAppState();
                updateConfiguredScoreSummary();
            });
        });

        document.getElementById('part2ModeSelect').addEventListener('change', (e) => {
            appState.grading.part2Mode = e.target.value;
            saveAppState();
        });

        document.getElementById('thresholdSlider').addEventListener('input', (e) => {
            appState.grading.threshold = parseInt(e.target.value) || 45;
            document.getElementById('thresholdLabel').textContent = `${appState.grading.threshold}%`;
            saveAppState();
        });

        document.getElementById('soundToggle').addEventListener('change', (e) => {
            appState.grading.soundEnabled = e.target.checked;
            saveAppState();
        });

        document.getElementById('geminiOcrToggle').addEventListener('change', (e) => {
            appState.grading.geminiOcrEnabled = e.target.checked;
            saveAppState();
            showToast(e.target.checked ? 'Đã bật Gemini AI đọc chữ viết tay Mã đề!' : 'Đã chuyển sang chế độ đọc Mã đề Offline.');
        });

        document.getElementById('geminiApiKeyInput').addEventListener('input', (e) => {
            appState.grading.geminiApiKey = e.target.value.trim();
            saveAppState();
        });

        function downloadStandaloneAppHtml() {
            try {
                const fullHtml = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
                const blob = new Blob([fullHtml], { type: 'text/html;charset=utf-8' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = 'Cham_Thi_Trac_Nghiem_PhamHau_Edu.html';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                showToast('Đã tải file Cham_Thi_Trac_Nghiem_PhamHau_Edu.html về máy!');
            } catch (err) {
                showToast('Lỗi khi tải file, hãy dùng nút Copy ở góc phải khung code.');
            }
        }

        function playBeepSound() {
            if (!appState.grading.soundEnabled) return;
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(880, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.14);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.14);
            } catch (e) {
                // Bỏ qua nếu trình duyệt chặn âm thanh tự động
            }
        }

        window.onload = () => {
            lucide.createIcons();
            bindAllInputsToState();
            refreshOmrDesignAndSync();
        };
    </script>
</body>
</html>