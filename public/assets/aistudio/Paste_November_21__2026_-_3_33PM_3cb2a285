        function getCurrentKeyObj() {
            const code = appState.grading.selectedCode;
            if (!appState.grading.answerKeys[code]) {
                appState.grading.answerKeys[code] = { part1: {}, part2: {}, part3: {} };
            }
            return appState.grading.answerKeys[code];
        }

        function syncGradingTabUI() {
            const codeSelect = document.getElementById('examCodeSelect');
            const codes = Object.keys(appState.grading.answerKeys);
            codeSelect.innerHTML = codes.map(c => `<option value="${c}" ${c === appState.grading.selectedCode ? 'selected' : ''}>Mã đề: ${c}</option>`).join('');

            const keyObj = getCurrentKeyObj();
            const p1Count = appState.config.part1Count;
            const p2Count = appState.config.part2Count;
            const p3Count = appState.config.part3Count;

            // --- Phần I ---
            const ed1 = document.getElementById('keyEditorPart1');
            if (p1Count > 0) {
                ed1.classList.remove('hidden');
                let filled1 = 0;
                let str = '';
                let gridHtml = '';
                for (let q = 1; q <= p1Count; q++) {
                    const ans = keyObj.part1[q] || '';
                    if (ans) filled1++;
                    str += ans || '-';
                    const btns = ['A', 'B', 'C', 'D'].map(ch => {
                        const active = ans === ch;
                        return `<button type="button" onclick="setPart1Answer(${q}, '${ch}')"
                            class="w-6 h-6 rounded text-[11px] font-bold transition cursor-pointer ${active ? 'bg-[#1e3a8a] text-white' : 'bg-white border border-slate-300 text-slate-600 hover:bg-blue-50'}">${ch}</button>`;
                    }).join('');
                    gridHtml += `
                        <div class="flex items-center justify-between bg-white px-2 py-1 rounded-lg border border-slate-200">
                            <span class="font-mono-code text-xs font-bold text-slate-700">C.${String(q).padStart(2, '0')}</span>
                            <div class="flex items-center gap-1">${btns}</div>
                        </div>
                    `;
                }
                document.getElementById('part1KeyProgress').textContent = `${filled1}/${p1Count}`;
                document.getElementById('quickKeyStringInput').value = str.replace(/-+$/g, '');
                document.getElementById('part1GridContainer').innerHTML = gridHtml;
            } else {
                ed1.classList.add('hidden');
            }

            // --- Phần II ---
            const ed2 = document.getElementById('keyEditorPart2');
            if (p2Count > 0) {
                ed2.classList.remove('hidden');
                let html2 = '';
                for (let q = 1; q <= p2Count; q++) {
                    if (!keyObj.part2[q]) keyObj.part2[q] = {};
                    const subsHtml = ['a', 'b', 'c', 'd'].map(sub => {
                        const val = keyObj.part2[q][sub] || '';
                        return `
                            <div class="flex items-center gap-1 bg-white px-1.5 py-1 rounded border border-slate-200">
                                <span class="text-[11px] font-bold text-slate-700">${sub})</span>
                                <button type="button" onclick="setPart2Answer(${q}, '${sub}', 'Đ')"
                                    class="px-1.5 py-0.5 rounded text-[10px] font-bold cursor-pointer ${val === 'Đ' ? 'bg-[#059669] text-white' : 'bg-slate-100 text-slate-600'}">Đ</button>
                                <button type="button" onclick="setPart2Answer(${q}, '${sub}', 'S')"
                                    class="px-1.5 py-0.5 rounded text-[10px] font-bold cursor-pointer ${val === 'S' ? 'bg-[#dc2626] text-white' : 'bg-slate-100 text-slate-600'}">S</button>
                            </div>
                        `;
                    }).join('');
                    html2 += `
                        <div class="space-y-1">
                            <div class="text-xs font-bold text-[#1e3a8a]">Câu ${q}:</div>
                            <div class="grid grid-cols-4 gap-1">${subsHtml}</div>
                        </div>
                    `;
                }
                document.getElementById('part2GridContainer').innerHTML = html2;
            } else {
                ed2.classList.add('hidden');
            }

            // --- Phần III ---
            const ed3 = document.getElementById('keyEditorPart3');
            if (p3Count > 0) {
                ed3.classList.remove('hidden');
                let html3 = '';
                for (let q = 1; q <= p3Count; q++) {
                    const val = keyObj.part3[q] || '';
                    html3 += `
                        <div class="flex items-center justify-between gap-2 bg-white p-2 rounded-lg border border-slate-200">
                            <span class="text-xs font-bold text-slate-700 shrink-0">Câu ${q}:</span>
                            <input type="text" maxlength="4" value="${val}" onchange="setPart3Answer(${q}, this.value)"
                                placeholder="VD: -2,5"
                                class="w-full rounded border border-slate-300 px-2 py-1 text-right font-mono-code font-bold text-xs text-[#1e3a8a] focus:border-[#1e3a8a] focus:outline-none">
                        </div>
                    `;
                }
                document.getElementById('part3GridContainer').innerHTML = html3;
            } else {
                ed3.classList.add('hidden');
            }

            // Cập nhật lại các trường Thang điểm nếu đang ở chế độ tự chia đều
            if (appState.grading.scorePreset === 'even10' || appState.grading.scorePreset === 'even100') {
                applyScorePreset(true);
            } else {
                updateConfiguredScoreSummary();
            }
        }

        // Các hàm điều khiển Thang điểm tùy chỉnh
        function updateConfiguredScoreSummary() {
            const p1 = Number(appState.grading.ptsPart1) || 0;
            const p2 = Number(appState.grading.ptsPart2) || 0;
            const p3 = Number(appState.grading.ptsPart3) || 0;

            document.getElementById('scorePresetSelect').value = appState.grading.scorePreset || 'standard';
            document.getElementById('ptsPart1Input').value = p1;
            document.getElementById('ptsPart2Input').value = p2;
            document.getElementById('ptsPart3Input').value = p3;
            document.getElementById('part2ModeSelect').value = appState.grading.part2Mode || 'progressive';

            const totalConfigured = +(
                appState.config.part1Count * p1 +
                appState.config.part2Count * p2 +
                appState.config.part3Count * p3
            ).toFixed(2);

            document.getElementById('configuredTotalScoreLabel').textContent = `${totalConfigured.toFixed(2)} điểm`;

            const warnBanner = document.getElementById('scoreWarningBanner');
            const totalBox = document.getElementById('configuredTotalBox');
            const isStandard10 = Math.abs(totalConfigured - 10) < 0.01;
            const isStandard100 = appState.grading.scorePreset === 'even100' && Math.abs(totalConfigured - 100) < 0.05;

            if (!isStandard10 && !isStandard100 && totalConfigured > 0) {
                warnBanner.classList.remove('hidden');
                document.getElementById('scoreWarningText').textContent =
                    `Lưu ý: Tổng điểm cấu hình hiện là ${totalConfigured.toFixed(2)}đ (khác thang 10.00đ).`;
                totalBox.className = 'p-2.5 rounded-xl bg-amber-50 border border-amber-300 flex items-center justify-between';
            } else {
                warnBanner.classList.add('hidden');
                totalBox.className = 'p-2.5 rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-between';
            }
        }

        function applyScorePreset(silent = false) {
            const mode = document.getElementById('scorePresetSelect').value;
            appState.grading.scorePreset = mode;

            const totalQ = appState.config.part1Count + appState.config.part2Count + appState.config.part3Count;
            if (mode === 'standard') {
                appState.grading.ptsPart1 = 0.25;
                appState.grading.ptsPart2 = 1.0;
                appState.grading.ptsPart3 = 0.5;
            } else if (mode === 'even10') {
                const perQ = totalQ > 0 ? +(10 / totalQ).toFixed(4) : 0;
                appState.grading.ptsPart1 = perQ;
                appState.grading.ptsPart2 = perQ;
                appState.grading.ptsPart3 = perQ;
            } else if (mode === 'even100') {
                const perQ = totalQ > 0 ? +(100 / totalQ).toFixed(4) : 0;
                appState.grading.ptsPart1 = perQ;
                appState.grading.ptsPart2 = perQ;
                appState.grading.ptsPart3 = perQ;
            }

            updateConfiguredScoreSummary();
            saveAppState();
            if (!silent) showToast('Đã cập nhật cấu hình thang điểm!');
        }

        function autoDistributePoints10() {
            document.getElementById('scorePresetSelect').value = 'even10';
            applyScorePreset(false);
        }

        function setPart1Answer(q, ch) {
            const keyObj = getCurrentKeyObj();
            keyObj.part1[q] = (keyObj.part1[q] === ch) ? '' : ch;
            saveAppState();
            syncGradingTabUI();
        }

        function setPart2Answer(q, sub, val) {
            const keyObj = getCurrentKeyObj();
            if (!keyObj.part2[q]) keyObj.part2[q] = {};
