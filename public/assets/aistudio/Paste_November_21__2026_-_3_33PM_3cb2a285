<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CHẤM THI TRẮC NGHIỆM THÔNG MINH | PHẠM HẬU -EDU</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Be Vietnam Pro, Inter & Roboto Mono -->
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&family=Roboto+Mono:wght@500;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Tesseract.js OCR (Hỗ trợ nhận diện chữ số viết tay dự phòng khi không dùng Gemini) -->
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>

    <style>
        body {
            font-family: 'Be Vietnam Pro', 'Inter', 'Segoe UI', Arial, sans-serif;
            background-color: #f1f5f9;
            color: #0f172a;
            margin: 0;
            padding: 0;
        }

        .font-mono-code {
            font-family: 'Roboto Mono', monospace;
        }

        /* Thanh cuộn tinh gọn */
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Khung chứa Canvas tờ phiếu A4/A5 */
        #sheetPreviewCanvas {
            background: #ffffff;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            max-width: 100%;
            height: auto;
            display: block;
            margin: 0 auto;
        }

        /* Khu vực in ẩn bình thường, chỉ hiện chuẩn 1:1 khi gọi window.print() */
        #printOnlyContainer {
            display: none;
        }

        @media print {
            body, html {
                background: #ffffff !important;
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                height: 100% !important;
                overflow: visible !important;
            }
            #appRoot, #toastBox, #reviewModal {
                display: none !important;
            }
            #printOnlyContainer {
                display: block !important;
                width: 100% !important;
                height: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            #printImage {
                width: 100%;
                height: auto;
                display: block;
                page-break-after: avoid;
                page-break-inside: avoid;
            }
        }
    </style>
    <style id="dynamicPrintStyle">
        @page {
            size: A4 portrait;
            margin: 0;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- VÙNG IN ĐỘC LẬP CHUẨN TỶ LỆ 1:1 -->
    <div id="printOnlyContainer">
        <img id="printImage" src="" alt="Phiếu trả lời trắc nghiệm OMR">
    </div>

    <!-- GIAO DIỆN CHÍNH CỦA ỨNG DỤNG -->
    <div id="appRoot" class="flex flex-col min-h-screen lg:h-screen lg:overflow-hidden">
        
        <!-- HEADER THƯƠNG HIỆU & CHUYỂN TAB -->
        <header class="bg-[#1e3a8a] text-white shadow-md z-30 shrink-0">
            <div class="max-w-[1600px] mx-auto px-4 py-2.5 flex flex-col md:flex-row items-center justify-between gap-3">
                <!-- Logo & Tên hệ thống -->
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-white/15 border border-white/25 flex items-center justify-center shrink-0">
                        <i data-lucide="scan-line" class="w-6 h-6 text-emerald-300"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2 flex-wrap">
                            <h1 class="font-extrabold text-sm sm:text-base tracking-wide uppercase">
                                CHẤM THI TRẮC NGHIỆM THÔNG MINH
                            </h1>
                            <span class="px-2 py-0.5 text-[11px] font-bold bg-amber-400 text-slate-950 rounded-md tracking-wider">
                                PHẠM HẬU -EDU
                            </span>
                        </div>
                        <p class="text-[11px] text-blue-200 hidden sm:block">
                            Hệ thống thiết kế phiếu OMR tùy biến &amp; chấm điểm tự động chuẩn tọa độ 100%
                        </p>
                    </div>
                </div>

                <!-- 2 Tab Điều Hướng Lớn & Nút Tải App -->
                <nav class="flex items-center bg-blue-950/60 p-1 rounded-xl border border-blue-700/60 w-full md:w-auto">
                    <button id="tabBtn1" type="button" onclick="switchTab(1)"
                        class="flex-1 md:flex-initial px-4 py-2 rounded-lg text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition cursor-pointer bg-white text-[#1e3a8a] shadow-sm">
                        <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                        <span>1. Thiết kế &amp; In Phiếu OMR</span>
                    </button>
                    <button id="tabBtn2" type="button" onclick="switchTab(2)"
                        class="flex-1 md:flex-initial px-4 py-2 rounded-lg text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition cursor-pointer text-blue-100 hover:text-white">
                        <i data-lucide="camera" class="w-4 h-4"></i>
                        <span>2. Chấm Bài &amp; Xuất Điểm</span>
                    </button>
                    <button type="button" onclick="downloadStandaloneAppHtml()" title="Tải toàn bộ ứng dụng thành 1 file HTML để mở offline hoặc đưa lên mạng"
                        class="ml-1 px-3 py-2 rounded-lg text-xs font-bold flex items-center justify-center gap-1.5 transition cursor-pointer bg-emerald-500 hover:bg-emerald-400 text-slate-950 shrink-0">
                        <i data-lucide="download" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">Tải App (.HTML)</span>
                    </button>
                </nav>
            </div>
        </header>

        <!-- =====================================================================
             TAB 1: THIẾT KẾ & IN PHIẾU OMR TÙY BIẾN
             ===================================================================== -->
        <section id="tabContent1" class="flex-1 flex flex-col lg:flex-row lg:overflow-hidden">
            
            <!-- CỘT TRÁI (35%): BẢNG ĐIỀU KHIỂN CẤU HÌNH PHIẾU -->
            <aside class="w-full lg:w-[35%] xl:w-[33%] bg-white border-b lg:border-b-0 lg:border-r border-slate-200 flex flex-col lg:h-full">
                <div class="p-4 sm:p-5 overflow-y-auto custom-scrollbar flex-1 space-y-5">
                    
                    <!-- Khối 1: Mẫu cấu trúc & Tùy chỉnh số câu -->
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-extrabold uppercase tracking-wider text-[#1e3a8a] flex items-center gap-1.5">
                                <i data-lucide="sliders" class="w-4 h-4"></i> Cấu trúc đề thi &amp; Số câu
                            </span>
                            <span id="badgeTotalQ" class="text-[11px] font-bold px-2 py-0.5 rounded bg-blue-50 text-[#1e3a8a] border border-blue-200">
                                Tổng: 40 câu
                            </span>
                        </div>

                        <div>
                            <label for="presetSelect" class="block text-xs font-semibold text-slate-700 mb-1">Chọn mẫu nhanh hoặc tùy chỉnh</label>
                            <select id="presetSelect" class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-800 focus:border-[#1e3a8a] focus:bg-white focus:outline-none">
                                <option value="custom">Tùy chỉnh số câu tự do (Linh hoạt)</option>
                                <option value="40abcd" selected>Mẫu chuẩn: 40 câu ABCD</option>
                                <option value="50abcd">Mẫu chuẩn: 50 câu ABCD</option>
                                <option value="bgd2025">Cấu trúc mới Bộ GD&amp;ĐT (12 ABCD + 4 Đ/S + 6 TLN)</option>
                            </select>
                        </div>

                        <!-- Nhập số câu từng phần -->
                        <div class="grid grid-cols-3 gap-2 pt-1">
                            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200">
                                <label for="numPart1" class="block text-[11px] font-bold text-slate-700 mb-1">Phần I (ABCD)</label>
                                <input type="number" id="numPart1" min="0" max="100" value="40"
                                    class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-center font-mono-code font-bold text-sm text-[#1e3a8a] focus:border-[#1e3a8a] focus:outline-none">
                                <span class="block text-[10px] text-slate-400 text-center mt-0.5">0 – 100 câu</span>
                            </div>

                            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200">
                                <label for="numPart2" class="block text-[11px] font-bold text-slate-700 mb-1">Phần II (Đ/S)</label>
                                <input type="number" id="numPart2" min="0" max="10" value="0"
                                    class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-center font-mono-code font-bold text-sm text-[#059669] focus:border-[#1e3a8a] focus:outline-none">
                                <span class="block text-[10px] text-slate-400 text-center mt-0.5">0 – 10 câu</span>
                            </div>

                            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200">
                                <label for="numPart3" class="block text-[11px] font-bold text-slate-700 mb-1">Phần III (TLN)</label>
                                <input type="number" id="numPart3" min="0" max="10" value="0"
                                    class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-center font-mono-code font-bold text-sm text-amber-700 focus:border-[#1e3a8a] focus:outline-none">
                                <span class="block text-[10px] text-slate-400 text-center mt-0.5">0 – 10 câu</span>
                            </div>
                        </div>
                    </div>

                    <hr class="border-slate-200">

                    <!-- Khối 2: Khổ giấy & Cấu hình ô Mã đề viết tay -->
                    <div class="space-y-3">
                        <span class="text-xs font-extrabold uppercase tracking-wider text-[#1e3a8a] flex items-center gap-1.5">
                            <i data-lucide="layout-grid" class="w-4 h-4"></i> Khổ giấy thông minh &amp; Ô Mã đề
                        </span>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                            <div>
                                <div class="flex items-center justify-between mb-1">
                                    <label for="paperSizeSelect" class="block text-xs font-semibold text-slate-700">Chế độ khổ giấy</label>
                                    <span id="autoPaperBadge" class="text-[10px] font-extrabold px-1.5 py-0.5 rounded bg-emerald-100 text-[#059669]">
                                        Đang dùng: A4
                                    </span>
                                </div>
                                <select id="paperSizeSelect" class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-2 text-xs sm:text-sm font-semibold text-slate-800 focus:border-[#1e3a8a] focus:outline-none">
                                    <option value="AUTO" selected>Tự động (A5 ít câu / A4 nhiều câu)</option>
                                    <option value="A5">Ép khổ A5 (148 × 210 mm)</option>
                                    <option value="A4">Ép khổ A4 (210 × 297 mm)</option>
                                </select>
                            </div>
                            <div>
                                <label for="examCodeDigitsSelect" class="block text-xs font-semibold text-slate-700 mb-1">Số ô viết Mã đề</label>
                                <select id="examCodeDigitsSelect" class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-2 text-xs sm:text-sm font-medium text-slate-800 focus:border-[#1e3a8a] focus:outline-none">
                                    <option value="3" selected>3 ô viết tay (101)</option>
                                    <option value="4">4 ô viết tay (1001)</option>
                                </select>
                            </div>
                        </div>

                        <!-- Tùy chọn ghép 2 phiếu A5 trên 1 tờ A4 ngang khi ở khổ A5 -->
                        <div id="twoUpOptionBox" class="hidden p-2.5 rounded-xl bg-amber-50 border border-amber-300 space-y-1.5">
                            <label class="flex items-center justify-between gap-2 cursor-pointer select-none">
                                <span class="text-xs font-bold text-amber-950 flex items-center gap-1.5">
                                    <i data-lucide="scissors" class="w-4 h-4 text-amber-700 shrink-0"></i>
                                    <span>Xếp 2 phiếu A5 trên 1 tờ A4 ngang</span>
                                </span>
                                <input type="checkbox" id="twoUpA4Checkbox" checked class="w-4 h-4 rounded accent-[#1e3a8a] cursor-pointer">
                            </label>
                            <p class="text-[11px] text-amber-800 leading-snug">
                                In 2 phiếu song song trên 1 mặt giấy A4 nằm ngang, có đường nét đứt ở giữa để cắt đôi. Mỗi nửa A5 giữ nguyên 4 điểm neo OMR độc lập.
                            </p>
                        </div>

                        <div class="p-2.5 rounded-xl bg-emerald-50/80 border border-emerald-200 text-[11px] text-emerald-900 flex items-start gap-2">
                            <i data-lucide="pen-tool" class="w-4 h-4 text-[#059669] shrink-0 mt-0.5"></i>
                            <span>Khi ít câu (≤ 32 câu), hệ thống tự chuyển sang <strong>khổ A5 tiết kiệm giấy</strong>. Học sinh viết trực tiếp <strong>Mã đề bằng bút mực</strong> vào khung góc phải.</span>
                        </div>
                    </div>

                    <hr class="border-slate-200">

                    <!-- Khối 3: Tiêu đề hành chính trên phiếu -->
                    <div class="space-y-3">
                        <span class="text-xs font-extrabold uppercase tracking-wider text-[#1e3a8a] flex items-center gap-1.5">
                            <i data-lucide="type" class="w-4 h-4"></i> Thông tin tiêu đề phiếu
                        </span>

                        <div>
                            <label for="schoolInput" class="block text-xs font-semibold text-slate-700 mb-1">Tên trường / Đơn vị</label>
                            <input type="text" id="schoolInput" value="TRƯỜNG THPT HỒNG NGỰ 3 - TỔ TOÁN"
                                class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-800 focus:border-[#1e3a8a] focus:outline-none">
                        </div>

                        <div>
                            <label for="examTitleInput" class="block text-xs font-semibold text-slate-700 mb-1">Tiêu đề kỳ thi</label>
                            <input type="text" id="examTitleInput" value="KIỂM TRA ĐÁNH GIÁ ĐỊNH KỲ"
                                class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-800 focus:border-[#1e3a8a] focus:outline-none">
                        </div>

                        <div class="grid grid-cols-2 gap-2.5">
                            <div>
                                <label for="subjectInput" class="block text-xs font-semibold text-slate-700 mb-1">Môn thi</label>
                                <input type="text" id="subjectInput" value="TOÁN HỌC"
                                    class="w-full rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-800 focus:border-[#1e3a8a] focus:outline-none">
                            </div>
                            <div>
                                <label for="durationInput" class="block text-xs font-semibold text-slate-700 mb-1">Thời gian</label>
                                <input type="text" id="durationInput" value="45 phút"
                                    class="w-full rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-800 focus:border-[#1e3a8a] focus:outline-none">
                            </div>
                        </div>
                    </div>

                    <!-- Ghi chú đồng bộ -->
                    <div class="p-3 rounded-xl bg-blue-50 border border-blue-200 text-xs text-blue-900 flex items-start gap-2.5">
                        <i data-lucide="refresh-cw" class="w-4 h-4 text-[#1e3a8a] shrink-0 mt-0.5"></i>
                        <p class="leading-relaxed">
                            Mọi thay đổi về số câu và cấu trúc ở đây sẽ <strong>tự động đồng bộ 100%</strong> với hệ thống nhận diện tọa độ tại <strong>Tab 2 (Chấm Bài)</strong>.
                        </p>
                    </div>
                </div>

                <!-- Nút hành động xuất bản dưới đáy -->
                <div class="p-4 bg-slate-50 border-t border-slate-200 space-y-2 shrink-0">
                    <button type="button" onclick="printOmrSheet()"
                        class="w-full py-3 px-4 bg-[#1e3a8a] hover:bg-blue-900 active:bg-blue-950 text-white font-bold text-sm rounded-xl shadow-sm flex items-center justify-center gap-2 transition cursor-pointer">
                        <i data-lucide="printer" class="w-5 h-5"></i>
                        <span id="btnPrintText">In Phiếu / Lưu PDF (Chuẩn 1:1)</span>
                    </button>
                    <div class="grid grid-cols-1 gap-2" id="downloadPngButtonsGrid">
                        <button type="button" onclick="downloadSingleBlankPng()"
                            class="w-full py-2 px-3 bg-white hover:bg-slate-100 text-slate-800 font-semibold text-xs rounded-xl border border-slate-300 flex items-center justify-center gap-1.5 transition cursor-pointer">
                            <i data-lucide="file-image" class="w-4 h-4 text-[#059669] shrink-0"></i>
                            <span id="btnDownloadSingleText">Tải ảnh phiếu đơn (.PNG)</span>
                        </button>
                        <button id="btnDownload2UpPng" type="button" onclick="download2UpBlankPng()"
                            class="hidden w-full py-2 px-3 bg-emerald-50 hover:bg-emerald-100 text-[#059669] font-bold text-xs rounded-xl border border-emerald-300 flex items-center justify-center gap-1.5 transition cursor-pointer">
                            <i data-lucide="columns-2" class="w-4 h-4 shrink-0"></i>
                            <span>Tải tờ A4 ghép đôi (.PNG)</span>
                        </button>
                    </div>
                </div>
            </aside>

            <!-- CỘT PHẢI (65%): KHUNG XEM TRƯỚC PHIẾU OMR -->
            <main class="w-full lg:w-[65%] xl:w-[67%] bg-slate-200/80 overflow-y-auto custom-scrollbar p-4 sm:p-6 flex flex-col items-center">
                <div class="w-full max-w-[920px] flex items-center justify-between mb-3 px-1">
                    <div class="flex items-center gap-2 text-xs font-semibold text-slate-600">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#059669]"></span>
                        <span id="previewMetaText">Bản vẽ vector độ phân giải cao • Khổ A4 (210 × 297 mm)</span>
                    </div>
                    <button type="button" onclick="switchTab(2)"
                        class="text-xs font-bold text-[#1e3a8a] hover:underline flex items-center gap-1 cursor-pointer">
                        <span>Chuyển sang Chấm bài ngay</span>
                        <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                    </button>
                </div>

                <!-- Canvas hiển thị tờ phiếu OMR -->
                <div id="previewCanvasWrapper" class="w-full max-w-[780px] pb-8 transition-all duration-200">
                    <canvas id="sheetPreviewCanvas"></canvas>
                </div>
            </main>
        </section>

        <!-- =====================================================================
             TAB 2: CHẤM BÀI & XUẤT ĐIỂM (ĐỒNG BỘ TỌA ĐỘ TỰ ĐỘNG)
             ===================================================================== -->
        <section id="tabContent2" class="hidden flex-1 flex-col lg:flex-row lg:overflow-hidden">
            
            <!-- CỘT TRÁI (35%): CẤU HÌNH ĐÁP ÁN, MÃ ĐỀ & THANG ĐIỂM -->
            <aside class="w-full lg:w-[35%] xl:w-[33%] bg-white border-b lg:border-b-0 lg:border-r border-slate-200 flex flex-col lg:h-full">
                <div class="p-4 sm:p-5 overflow-y-auto custom-scrollbar flex-1 space-y-5">
                    
                    <!-- Tóm tắt cấu trúc đang đồng bộ -->
                    <div class="p-3 rounded-xl bg-slate-900 text-white flex items-center justify-between">
                        <div>
                            <div class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold">Cấu trúc đang áp dụng</div>
                            <div id="syncSummaryText" class="text-xs sm:text-sm font-bold text-emerald-300 mt-0.5">
                                40 câu ABCD • Khổ A4
                            </div>
                        </div>
                        <button type="button" onclick="switchTab(1)"
                            class="px-2.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-xs font-semibold transition cursor-pointer">
                            Đổi cấu trúc
                        </button>
                    </div>

                    <!-- 1. Quản lý Mã đề -->
                    <div class="space-y-2.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-extrabold uppercase tracking-wider text-[#1e3a8a] flex items-center gap-1.5">
                                <i data-lucide="key-round" class="w-4 h-4"></i> Quản lý Mã đề &amp; Đáp án
                            </span>
                            <button type="button" onclick="generateRandomAnswerKey()"
                                class="text-[11px] font-bold text-[#059669] hover:text-emerald-800 bg-emerald-50 hover:bg-emerald-100 px-2.5 py-1 rounded-lg border border-emerald-200 transition cursor-pointer">
                                + Tạo đáp án mẫu ngẫu nhiên
                            </button>
                        </div>

                        <div class="flex items-center gap-2">
                            <select id="examCodeSelect" onchange="onSelectExamCode()"
                                class="flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-[#1e3a8a] focus:border-[#1e3a8a] focus:outline-none">
                            </select>
                            <button type="button" onclick="addNewExamCode()"
                                class="px-3 py-2 rounded-lg bg-[#1e3a8a] hover:bg-blue-900 text-white text-xs font-bold shrink-0 cursor-pointer">
                                + Mã đề
                            </button>
                            <button type="button" onclick="deleteCurrentExamCode()" title="Xóa mã đề này"
                                class="p-2 rounded-lg border border-slate-300 hover:bg-red-50 hover:text-[#dc2626] hover:border-red-200 text-slate-500 transition cursor-pointer">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>

                    <!-- 2. Nhập đáp án Phần I (ABCD) -->
                    <div id="keyEditorPart1" class="space-y-2.5">
                        <div class="flex items-center justify-between">
